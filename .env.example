# Local development environment. Copy to `.env` (git-ignored) and adjust.
# In Kubernetes these values come from Helm values.yaml -> ConfigMap / Secret.

# ---- Application ----
APP_ENV=development            # development | staging | production
LOG_LEVEL=debug                # debug | info | warn | error
HTTP_ADDR=:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Database (SECRET in Kubernetes) ----
DATABASE_URL=postgres://tropical:tropical_dev_password@localhost:5432/tropical_fnb?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2

# ---- docker-compose only (local PostgreSQL container) ----
POSTGRES_USER=tropical
POSTGRES_PASSWORD=tropical_dev_password
POSTGRES_DB=tropical_fnb
